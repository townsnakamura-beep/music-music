{
  "name": "guitar-jam",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "main": "electron.cjs",
  "scripts": {
    "start": "node server.js",
    "dev": "vite",
    "electron": "set NODE_ENV=development && electron electron.cjs",
    "server": "node server.js",
    "build": "vite build",
    "preview": "vite preview",
    "dist": "vite build && electron-builder"
  },
  "build": {
    "appId": "com.musicmusic.app",
    "productName": "ミュージックミュージック",
    "files": [
      "dist/**/*",
      "electron.cjs",
      "preload.cjs",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "node_modules/naudiodon",
        "to": "naudiodon",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "naudiodon": "^2.3.6",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "vite": "^8.0.12"
  },
  "allowScripts": {
    "naudiodon@2.3.6": true
  }
}
