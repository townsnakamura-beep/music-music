{
  "name": "guitar-jam",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "electron.cjs",
  "scripts": {
    "start": "node server.js",
    "dev": "vite",
    "electron": "set NODE_ENV=development && electron electron.cjs",
    "server": "node server.js",
    "build": "vite build",
    "preview": "vite preview",
    "dist": "vite build && electron-builder"
  },
"build": {
  "appId": "com.oto.app",
  "productName": "ミュージックミュージック",
  "icon": "oto.ico",
  "files": [
    "dist/**/*",
    "electron.cjs",
    "preload.cjs",
    "node_modules/**/*"
  ],,
    "extraResources": [
      {
        "from": "public",
        "to": "public",
        "filter": ["**/*"]
      }
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerLanguages": ["ja"],
      "language": "1041"
    }
  },
  "dependencies": {
    "audify": "^1.10.1",
    "naudiodon": "^2.3.6",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "vite": "^8.0.12"
  }
}
